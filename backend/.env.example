# VeriLens AI Verification Engine Configuration
APP_NAME=VeriLens AI Backend
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./verilens.db

# Storage & Upload Limits
MAX_IMAGE_SIZE_MB=10
MAX_TEXT_LENGTH=10000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp

# Verification & Search Settings
SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT_SECONDS=5.0
EVIDENCE_SCRAPE_TIMEOUT_SECONDS=4.0
ENABLE_TAMIL_OCR=false

# Search API Keys (Optional - falls back to DuckDuckGo/direct trusted scrape)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=
